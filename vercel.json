{
  "rewrites": [
    { "source": "/whatsapp", "destination": "/api/whatsapp" },
    { "source": "/instagram", "destination": "/api/instagram" },
    { "source": "/privacidade", "destination": "/privacy" }
  ],
  "headers": [
    {
      "source": "/convite",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/geladeira",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
