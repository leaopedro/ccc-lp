# Notion integration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redirect targets for /whatsapp and /instagram endpoints
WHATSAPP_URL=https://wa.me/5541900000000
INSTAGRAM_URL=https://instagram.com/casacar.club

# Instagram handle displayed in the Hero (without @, e.g. casacar.club)
VITE_INSTAGRAM_HANDLE=casacar.club

# Geladeira unlock (server-side only — NUNCA expor no browser/bundle)
# Secret: definir SOMENTE na Vercel (Project → Settings → Environment Variables).
FRIDGE_UNLOCK_API_KEY=
# Não-secretos (têm defaults no código — só defina para sobrescrever):
# FRIDGE_BACKEND_URL=https://ccc-app-production.up.railway.app
# FRIDGE_UNLOCK_PATH=/api/fridge/unlock

# Notion — onde o lead da geladeira é salvo (reusa o NOTION_TOKEN acima).
# ID do database que você vai criar (32 chars, sem hifens).
NOTION_FRIDGE_DATABASE_ID=

# Comma-separated list of form field IDs to hide (optional, defaults to none hidden)
# Available IDs: nome, email, whatsapp, carro, interesse
# Example: VITE_DISABLED_FIELDS=carro,interesse
VITE_DISABLED_FIELDS=
